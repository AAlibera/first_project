# ============================================
# PCB缺陷检测系统 - 环境配置示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# ============================================

# ============================================
# 应用基本配置
# ============================================
APP_NAME=PCB缺陷检测系统
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pcb_user
DB_PASSWORD=pcb_password
DB_DATABASE=pcb_platform

# ============================================
# JWT认证配置
# ============================================
# 生产环境请使用强随机密码，例如可以使用以下命令生成：
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-here-change-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# 检测模型配置
# ============================================
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
MAX_FILE_SIZE=50

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=10
LOG_ENABLE_JSON=false

# ============================================
# CORS配置
# ============================================
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
